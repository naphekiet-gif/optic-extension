{
  "manifest_version": 3,
  "name": "Optic",
  "version": "1.5.0",
  "description": "See your product builds as dynamic, explorable graphs. Paste any system description and explore it instantly.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Open Optic",
    "default_icon": "assets/icon-32.png"
  },
  "side_panel": {
    "default_path": "panel/index.html"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://api.anthropic.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  }
}
